# Primer administrador del sistema.
# Copia este archivo con el nombre .env.local, llena los datos y reinicia "npm run dev".
# .env.local no se sube a GitHub. La contraseña debe tener al menos 6 caracteres
# y conviene cambiarla desde la sección Usuarios apenas se entre por primera vez.
VITE_ADMIN_NAME=Nombre Apellido
VITE_ADMIN_USERNAME=nombre.apellido
VITE_ADMIN_PASSWORD=
