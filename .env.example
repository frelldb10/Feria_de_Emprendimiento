# Conexión a Supabase. Copia este archivo con el nombre .env.local y llena los datos
# (Supabase → Project Settings → API Keys). .env.local no se sube a GitHub.
# Usa la clave "publishable" (sb_publishable_...). Nunca pongas aquí la clave secreta.
VITE_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
